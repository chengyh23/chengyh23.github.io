<div class="news" style="margin-bottom: 2rem;">
    {% if site.data.news != blank %}
      {% assign news_size = site.data.news | size %}
      <div
        class="table-responsive"
        {% if include.limit and page.announcements.scrollable and news_size > 3 %}
          style="max-height: 60vw"
        {% endif %}
      >
        <table class="table table-sm table-borderless" style="margin-bottom: 0;">
          {% assign news = site.data.news | reverse %}
          {% if include.limit and page.announcements.limit %}
            {% assign news_limit = page.announcements.limit %}
          {% else %}
            {% assign news_limit = news_size %}
          {% endif %}
          {% for item in news limit: news_limit %}
            <tr style="border-spacing: 0; padding: 0;">
              <th scope="row" style="width: 20%; padding: 0.25rem 0; vertical-align: top;">{{ item.date | date: '%b %d, %Y' }}</th>
              <td style="padding: 0.25rem 0.5rem; vertical-align: top;">{{ item.text | emojify }}</td>
            </tr>
          {% endfor %}
        </table>
      </div>
    {% else %}
      <p>No news so far...</p>
    {% endif %}
  </div>